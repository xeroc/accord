
// Mainnet deploys sign with a local keypair: payer and upgrade authority
// are the same key. txtx cannot read environment variables, so the key
// path is an input set in txtx.yml (`deploy_key_path`). The keypair file
// pins the address by construction — no wallet popup to enforce against
// (supersedes the web_wallet + expected_address scheme, security review
// 2026-09-18).

signer "payer" "svm::secret_key" {
    description = "Pays fees for program deployments and operations"
    keypair_json = input.deploy_key_path
}

signer "authority" "svm::secret_key" {
    description = "Can upgrade programs and manage critical ops"
    keypair_json = input.deploy_key_path
}
