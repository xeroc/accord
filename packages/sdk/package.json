{
  "name": "@veridao/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for VeriDAO Accord + Mutual programs on Solana",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
