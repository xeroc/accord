{
  "name": "@veridao/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the VeriDAO Accord program on Solana",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json && node --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@anchor-lang/core": "^1.0.2",
    "@solana/kit": "^2.1.0",
    "@solana/web3.js": "^1.95.0",
    "@solana/spl-token": "^0.4.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/bn.js": "^5.1.6"
  }
}
