{
  "name": "@useaccord/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Accord program on Solana",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./evidence": {
      "types": "./dist/evidence/index.d.ts",
      "import": "./dist/evidence/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p tsconfig.json --noEmit && node --test src/**/*.test.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@noble/ciphers": "^1.0.0",
    "@noble/curves": "^1.9.7",
    "@noble/hashes": "^1.0.0",
    "@solana/kit": "^7.0.0",
    "bn.js": "^5.2.1"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.5.3",
    "@codama/renderers-js": "^2.3.1",
    "codama": "^1.10.0",
    "typescript": "^5.5.0",
    "@types/bn.js": "^5.1.6",
    "tsup": "^8.3.0"
  }
}
