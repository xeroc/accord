# Accord dApp environment.
# Copy to .env and set. VITE_ prefix exposes to the client (not secrets).

# Private rate-limited devnet RPC (e.g. https://devnet.useaccord.xyz or Helius).
VITE_DEVNET_RPC=https://api.devnet.solana.com

# Private mainnet RPC.
VITE_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Evidence Operator Daemon base URL (no trailing slash). Centralized operator
# (ADR-0011). The dApp POSTs encrypted manifests here on dispute file + recovery.
# One daemon per selected cluster; empty/unset falls back to the default shown.
# VITE_EVIDENCE_DAEMON_URL_DEVNET=https://api.devnet.useaccord.xyz
# VITE_EVIDENCE_DAEMON_URL_MAINNET=https://api.useaccord.xyz
# VITE_EVIDENCE_DAEMON_URL_LOCALNET defaults to the devnet value above.

# Evidence Operator pubkey (base58, ADR-0006/0011). Baked into every
# subaccord created via the dApp — resolved per selected cluster; empty =
# no operator. Must match a key in that cluster daemon's EVIDENCE_KEYRING.
# VITE_EVIDENCE_OPERATOR_DEVNET=OperAtOr1Pubkey111111111111111111111111111111
# VITE_EVIDENCE_OPERATOR_MAINNET=OperAtOr1Pubkey111111111111111111111111111111
# VITE_EVIDENCE_OPERATOR_LOCALNET defaults to the devnet value above.
