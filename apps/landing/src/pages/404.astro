---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 — Not found | Accord">
  <section class="flex min-h-[60svh] flex-col items-center justify-center px-6 text-center">
    <p class="font-mono text-sm uppercase tracking-[0.08em] text-amber">404</p>
    <h1 class="mt-4 font-sans text-4xl font-semibold tracking-[-0.02em] text-nearwhite sm:text-5xl">
      Not found.
    </h1>
    <p class="mt-4 max-w-md text-muted">
      This page doesn't exist. The primitive does.
    </p>
    <a
      href="/"
      class="mt-8 font-sans text-sm text-amber underline-offset-4 transition-colors hover:underline"
    >
      ← Back to useaccord.xyz
    </a>
  </section>
</Layout>
