---
import Waitlist from "./Waitlist.astro";
// §7 — Final CTA. The campaign question as the closing hook.
---

<section id="cta" class="border-t border-border/60 py-24 sm:py-32">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <h2 class="font-sans text-4xl font-semibold tracking-[-0.02em] text-amber sm:text-5xl">
      Who's right?
    </h2>
    <p class="mx-auto mt-5 max-w-md text-base text-muted">
      One email when v1 ships on mainnet. That's the whole list.
    </p>

    <div class="mt-9 flex justify-center">
      <Waitlist />
    </div>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-sm">
      <a href="https://docs.useaccord.xyz" class="text-body underline-offset-4 transition-colors hover:text-nearwhite hover:underline">Read the docs</a>
      <span class="text-border">·</span>
      <a href="https://t.me/useaccord" class="text-body underline-offset-4 transition-colors hover:text-nearwhite hover:underline" rel="noopener">Join the Telegram</a>
    </div>
  </div>
</section>
