# Canon Registry dApp environment.
# Copy to .env and set. VITE_ prefix exposes to the client (not secrets).

# Private rate-limited devnet RPC (e.g. https://devnet.useaccord.xyz or Helius).
VITE_DEVNET_RPC=https://api.devnet.solana.com

# Private mainnet RPC.
VITE_MAINNET_RPC=https://api.mainnet-beta.solana.com

# Evidence Operator Daemon base URL (no trailing slash). Centralized operator
# (ADR-0011). The dApp POSTs encrypted manifests here on challenge.
# One daemon per selected cluster; empty/unset falls back to the default shown.
# VITE_EVIDENCE_DAEMON_URL_DEVNET=https://api.devnet.useaccord.xyz
# VITE_EVIDENCE_DAEMON_URL_MAINNET=https://api.useaccord.xyz
# VITE_EVIDENCE_DAEMON_URL_LOCALNET defaults to the devnet value above.

# Evidence Operator Ed25519 pubkey (base58). Pinned onto every backing
# Subaccord at create_list — challenges encrypt evidence to this key, resolved
# per selected cluster. Must be derived from a seed in THAT cluster's daemon
# EVIDENCE_KEYRING; the daemon discloses the matching pubkey at GET /config.
# VITE_EVIDENCE_OPERATOR_ADDRESS_DEVNET=
# VITE_EVIDENCE_OPERATOR_ADDRESS_MAINNET=
# VITE_EVIDENCE_OPERATOR_ADDRESS_LOCALNET defaults to the devnet value above.

# Accord dApp base URL (origin, for dispute deep links — see DisputeStatusCard).
# No trailing slash. Deep link is `${VITE_ACCORD_APP_URL}/#/disputes/<addr>`.
VITE_ACCORD_APP_URL=https://app.useaccord.xyz

# Featured Canon list address (base58). Empty → featured slot hidden.
VITE_FEATURED_LIST=

# Explorer account URL template ({pubkey} placeholder). Used wherever an item
# (curated account) is shown: list rows, item detail hero, challenge page.
VITE_EXPLORER_ACCOUNT_URL=https://solscan.io/account/{pubkey}
