{
  "name": "@useaccord/cranker",
  "version": "0.1.0",
  "private": true,
  "description": "Accord Cranker — advances disputes through their lifecycle by calling permissionless instructions (milestone accord-27r5)",
  "type": "module",
  "bin": {
    "cranker": "./bin/cranker.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "bun run src/index.ts",
    "dev": "bun --watch run src/index.ts",
    "test": "bun test",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@solana/kit": "^7.0.0",
    "@useaccord/canon": "workspace:^",
    "@useaccord/sdk": "workspace:*",
    "@useaccord/synod": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
