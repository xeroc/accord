# Solana JSON-RPC endpoint the cranker reads + sends cranks to.
ACCORD_RPC_URL=http://127.0.0.1:8899

# Solana WebSocket endpoint (program-log subscription for immediate reconcile).
ACCORD_WS_URL=ws://127.0.0.1:8900

# Path to the protocol-subsidized fee-payer keypair JSON (64-byte uint8 array).
# Generate with: solana-keygen new -o ~/.config/solana/cranker.json
ACCORD_CRANKER_KEYPAIR=~/.config/solana/cranker.json

# MagicBlock VRF oracle queue (base-layer). Optional — auto-detected from the
# RPC URL: localhost → test queue, else → mainnet/devnet queue.
# Override only if you run a custom oracle queue.
# ACCORD_VRF_ORACLE_QUEUE=Cuj97ggrhhidhbu39TijNVqE74xvKJ69gDervRUXAxGh

# Canon GC module — closes Removed CanonItem PDAs and pockets the rent
# (close_item, bean accord-m5fd). Toggle listener + reconciler sweep off:
# CANON_GC_ENABLED=true

# Override the canon program id the GC module watches + cranks
# (defaults to the SDK's canonical address):
# CANON_PROGRAM_ID=can5ZhfgQpi7jymkxE7uEv4ZVm3X2f51KThTUtdWrFs
