# Accord Cranker — protocol-subsidized dispute lifecycle advancer (accord-27r5).
# RPC endpoint the reconciler polls for active disputes.
ACCORD_RPC_URL=http://127.0.0.1:8899
# WebSocket endpoint for the program-log listener (latency optimization).
ACCORD_WS_URL=ws://127.0.0.1:8900
# Funded keypair that signs (and pays for) all crank transactions.
ACCORD_CRANKER_KEYPAIR=~/.config/solana/id.json
