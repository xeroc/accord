# Solana JSON-RPC endpoint the daemon reads + votes over.
JURAT_RPC_URL=http://127.0.0.1:8899


# WebSocket endpoint — send confirmation + program-log hints. Optional:
# derived from JURAT_RPC_URL (http→ws, port+1). Providers with a distinct WS
# host must set it explicitly.
# JURAT_WS_URL=ws://127.0.0.1:8900

# Operator keypair JSON (64-byte uint8 array) — the single juror identity.
# Generate with: solana-keygen new -o ~/.config/solana/jurat.json
JURAT_KEYPAIR_PATH=~/.config/solana/jurat.json

# LLM primary endpoint (openai-compatible). The retry ladder is
# primary → fallback → clean abstain; a bad vote is never cast.
JURAT_LLM_BASE_URL=http://llm.internal/v1
JURAT_LLM_API_KEY=sk-...
JURAT_LLM_MODEL=some-model

# LLM fallback endpoint — all three vars together or none.
# JURAT_LLM_FALLBACK_BASE_URL=http://fallback.internal/v1
# JURAT_LLM_FALLBACK_API_KEY=sk-...
# JURAT_LLM_FALLBACK_MODEL=some-model

# MCP server definitions JSON for agent tools (optional, v1 ships none).
# JURAT_MCP_SERVERS_PATH=./mcp-servers.json

# Join gates — the full conservative set (milestone accord-g69g §3).
# Comma-separated base58 mint allowlists:
JURAT_STAKING_TOKENS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # gitleaks:allow — public mainnet USDC mint, not a secret
JURAT_FEE_TOKENS=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v # gitleaks:allow — public mainnet USDC mint, not a secret
# Acceptable pools (raw base units, optional bounds):
# JURAT_MIN_STAKE_MIN=1000000
# JURAT_MIN_STAKE_MAX=1000000000
# JURAT_FEE_PER_JUROR_MIN=1000
# JURAT_FEE_PER_JUROR_MAX=100000
# Max alpha_bps (default 2000 = 20%):
# JURAT_ALPHA_BPS_CAP=2000
# Min commit_window in seconds — agent runtime budget (default 600):
# JURAT_COMMIT_WINDOW_FLOOR=600
# Stake economics (raw base units, per staking token). Each join stakes
# exactly the pool's own min_stake — there is no per-join amount knob (it
# could not be unit-correct across mints); upstaking is manual by design.
JURAT_STAKE_BUDGET=1000000000
JURAT_SUBACCORD_CAP=500000000
JURAT_RESERVE_FLOOR=100000000
# SOL the operator must retain for tx fees (raw lamports).
# JURAT_MIN_SOL_LAMPORTS=50000000

# Reconcile scan interval in ms — the truth loop (WS hints only add timeliness).
# JURAT_SCAN_INTERVAL_MS=60000

# Evidence daemon (ADR-0011/0034) — both vars together or none. Unset: the
# join watch still runs, but duties hold (no verdicts can be produced).
# JURAT_EVIDENCE_URL=http://evidence.internal
# JURAT_DELIVERY_KEY_PATH=./state/delivery.key

# Telegram alerts — both vars together or none.
# JURAT_TELEGRAM_TOKEN=123456:ABC-...
# JURAT_TELEGRAM_CHAT_ID=123456789

# Autonomy gate: default true — commit/reveal never send unless set to
# false/0/no. A malformed value aborts boot rather than disarming silently.
# JURAT_DRY_RUN=true

# Local state dir (duties, salts, cursor, joined-subaccord book).
# JURAT_STATE_DIR=./state

# Jury telemetry (ADR-0037) — push agent traces to the evidence daemon.
# Unset JURAT_TRACE_URL = tracing off (no-op sink).
# JURAT_TRACE_URL=http://evidence.internal
# JURAT_TRACE_MODE=sealed
