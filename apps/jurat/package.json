    "dev": "bun --watch run src/main.ts",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^2",
    "@ai-sdk/openai-compatible": "^3",
    "@noble/curves": "^1.9.7",
    "@solana/kit": "^7.0.0",
    "@useaccord/sdk": "workspace:*",
    "ai": "^7",
    "zod": "^4"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bun": "^1.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
}
