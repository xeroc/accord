{
  "name": "@useaccord/jurat",
  "version": "0.3.0",
  "private": true,
  "description": "Jurat — agentic juror daemon for Accord: stakes, watches for drawn seats, runs an LLM agent over evidence, votes commit/reveal (milestone accord-g69g)",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
