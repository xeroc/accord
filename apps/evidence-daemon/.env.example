# -----------------------------------------------------------------------------
# Evidence Operator Daemon — example environment (.env.example)
# Copy to .env and fill in. Never commit a real .env.
# Source of truth: src/config.ts (loadConfig + loadServerConfig) + SPEC.md
# -----------------------------------------------------------------------------
# Required (daemon refuses to boot if any is missing/empty — src/config.ts:35)
EVIDENCE_RPC_URL=https://api.mainnet-beta.solana.com
EVIDENCE_PROGRAM_ID=RokLJyruq34Ubtaj8mFnQETKcZpNCbW6k6xsgrMoHEe
# Comma-separated list, one entry per operated Subaccord. Each entry is EITHER:
#   - A base58-encoded 32-byte Ed25519 seed, OR
#   - A path to a .json key file (e.g. /keys/operator1.json) containing the seed
#     as a JSON byte array ([..32..] or [..64..]) or { "secretKey": [..64..] }.
# The two formats may be mixed. The on-chain Subaccord.evidence_operator pubkey
# is the binding — the daemon derives each seed's pubkey and indexes by it.
# Unknown operator => 404.
EVIDENCE_KEYRING=

# Ciphertext backend (plaintext is never persisted — ADR-0006).
# Pick ONE backend; only the selected backend's vars are required.
#   EVIDENCE_STORAGE=s3  (default) → S3/MinIO. Requires the EVIDENCE_S3_* block.
#   EVIDENCE_STORAGE=fs            → local filesystem. Requires EVIDENCE_FS_ROOT_DIR.
EVIDENCE_STORAGE=s3

# --- S3 / MinIO backend (required when EVIDENCE_STORAGE=s3; ignored otherwise) ---
EVIDENCE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
EVIDENCE_S3_BUCKET=accord-evidence
EVIDENCE_S3_REGION=us-east-1
# Optional when running on IAM/IRSA; otherwise set BOTH together (or neither).
EVIDENCE_S3_ACCESS_KEY_ID=
EVIDENCE_S3_SECRET_ACCESS_KEY=
# true for MinIO; leave empty/false for AWS S3.
EVIDENCE_S3_FORCE_PATH_STYLE=false

# --- Local filesystem backend (required when EVIDENCE_STORAGE=fs; ignored otherwise) ---
# Directory holding evidence files. Created on first put if missing. Use an
# absolute path. Single-node only; for HA share one bucket via S3 instead.
# EVIDENCE_FS_ROOT_DIR=/var/lib/evidence

# -----------------------------------------------------------------------------
# Optional — server tuning (defaults shown). See src/config.ts:loadServerConfig.
# -----------------------------------------------------------------------------
# Listen port. Code defaults to 443; the Dockerfile overrides to 8080.
EVIDENCE_PORT=8080
# Per-IP requests/min (0 disables the in-process limiter).
EVIDENCE_RATE_LIMIT_PER_MIN=120
# Request body cap in bytes (0 = no cap). 10 MiB matches the k8s manifest.
EVIDENCE_MAX_EVIDENCE_BYTES=10485760
# Retention window past RulingFinalized, in days. Sweep not yet wired (v1).
EVIDENCE_RETENTION_DAYS=90
# Backend (S3 + RPC) health-probe timeout in ms.
EVIDENCE_HEALTH_TIMEOUT_MS=2000
# true ⇒ log X-Account-Key for accounting; never grants/denies access.
EVIDENCE_ACCOUNT_KEY_ENABLED=false
# true ⇒ honor X-Forwarded-For for rate limiting. ONLY behind a trusted LB
# that overwrites XFF; false (default) ignores it.
EVIDENCE_TRUST_PROXY=false
# CORS Access-Control-Allow-Origin value. "*" (default) allows any origin.
# Set to a specific origin (e.g. https://app.example) to restrict.
EVIDENCE_CORS_ORIGIN=*

# -----------------------------------------------------------------------------
# Optional — end-to-end TLS (paths to PEM files). Terminate at the LB/Ingress
# by default; only set both for in-pod TLS. Must be set together.
# -----------------------------------------------------------------------------
EVIDENCE_TLS_CERT=
EVIDENCE_TLS_KEY=
