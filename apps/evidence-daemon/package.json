  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/bs58": "^4.0.1",
    "@types/bun": "^1.3.0",
    "eslint": "^9.35.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0"
  }
