// canon-economics-30s — "passive pulse" (Strudel score, Canon family)
//
// Prebaked to public/audio/canon-economics-30s.wav (gitignored artifact) by:
//   pnpm --filter @useaccord/remotion score canon-economics-30s 30
// This exact file is also pasteable into https://strudel.cc (add
// `._punchcard()` to the last line there if you want the visualizer).
//
// 120 BPM grid: cpm 30 → 1 bar = 2.000s = 60 frames @30fps.
// bed runs the whole 30s; soft markers land on storyboard beats:
//   deflect 1.0 · hook-turn 2.625 · deposit 4.25 · yank-snap 7.0 ·
//   armor 10.75 · honest strike 18.0 · ruling 18.625 · bounty 1125 21.5 ·
//   takeaway 23.75 · 24.875 · endcard button 27.0
setcpm(30)

// ── bed ──
const kick = s("bd ~ bd ~").bank("RolandTR909").gain(.45) // pulse on 1 & 3
const tick = s("~ hh ~ hh").gain(.09).hpf(9000)           // whisper hats
const rimt = s("~ ~ rim ~").gain(.13)                     // wooden tick, deflections
// chord loop (one chord per bar): Ebmaj9 · Cm9 · Abmaj9 · Gm7
const arpA = note("eb3 [g3 bb3] [d4 f4] ~").s("piano").gain(.34).room(.35)
const arpB = note("c3 [g3 bb3] [d4 eb4] ~").s("piano").gain(.32).room(.35)
const arpC = note("ab2 [c3 eb3] [g3 bb3] ~").s("piano").gain(.32).room(.35)
const arpD = note("g2 [d3 f3] [bb3 d4] ~").s("piano").gain(.32).room(.35)
const pad = x => note(x).s("triangle").fm("<0 2 4>").clip(1).attack(.8).release(1.2).gain(.22).room(.4)
const hum = x => note(x).s("pluck").lpf(2600).gain(.18).room(.4) // canon accent — LPF'd harp top line

// ── S1 hook · 0–3.5s — almost nothing; one strike deflects, one doesn't ──
const b1 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.45), pad("eb2"), rimt) // deflect @1.0
const b2 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.45),
  note("[eb4,bb4] ~ ~ ~").s("piano").gain(.22).room(.45), pad("c2"),
  note("~ [~ ~ c3 ~] ~ ~").s("piano").gain(.19).room(.5).release(1.75)) // hook-turn @2.625 — "until one doesn't", ring damped

// ── S2 mechanism · 3.5–23.5s — arps enter hushed, loop steady ──
// 01 deposit · 3.5–9.5s
const b3 = stack(kick, arpC, tick, pad("ab2"),
  note("[~ ab4] c5 ~ ~").s("piano").gain(.155).room(.5))     // deposit @4.25 — pile welds in, rise
const b4 = stack(kick, arpD, tick, pad("g2"),
  note("~ ~ g3 ~").s("piano").gain(.18).room(.5).release(1.5)) // yank-snap @7.0 — no exit past a live challenge, ring damped
// body — loop runs, harp hum drifts on top
const b5 = stack(kick, arpA, tick, pad("eb2"), hum("f5"))
const b6 = stack(kick, arpB, tick, pad("c2"), hum("d5"),
  note("[~ g4] bb4 ~ ~").s("piano").gain(.155).room(.5))     // armor @10.75 — strike 1 plates, rise
const b7 = stack(kick, arpC, tick, pad("ab2"), hum("bb5"))
const b8 = stack(kick, arpD, tick, pad("g2"))                // strike 2 plates again — left to the eye
// 03 bounty · 16.5–23.5s
const b9 = stack(kick, arpA, tick, pad("eb2"))               // challenger squares up
const b10 = stack(kick, arpB, tick, pad("c2"),
  note("bb4 ~ ~ ~").s("piano").gain(.16).room(.5),            // honest strike lodges @18.0
  note("~ [~ ~ eb3 ~] ~ ~").s("piano").gain(.19).room(.5).release(1.75)) // ruling @18.625 — REMOVE, ring damped
const b11 = stack(kick, arpC, pad("ab2"),
  note("~ ~ ~ [ab3,eb4,g4,bb4,eb5]").s("piano").gain(.26).room(.5).release(1.5)) // Abmaj9 bloom @21.5 — the 1125 pile lands, ring damped


// ── S3 takeaway · 23.5–27s — bed thins so the two lines read ──
const b12 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.4), arpD.release(1.5), pad("g2"),
  note("~ ~ ~ [~ ~ bb4 ~]").s("piano").gain(.155).room(.5))  // line 1 @23.75 — failed attacks armor, rise
const b13 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.4), pad("eb2"),
  note("d5 [~ ~ ~ bb4] eb5 ~").s("piano").gain(.155).room(.5)) // line 2 @24.875 — honest strikes collect, rise

// ── S4 endcard · 27–30s — home ──
const b14 = stack(kick, arpA.release(.6), pad("eb2"),
  note("~ ~ [eb4,eb5] ~").s("piano").gain(.24).room(.45).release(.5)) // wordmark button @27.0 — piano ring damped
const b15 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.4),
  note("[eb3,g3,bb3,f4]").s("piano").sustain(.2).release(.8).gain(.3).room(.5)) // fades out by 29.0 — silent before 30

cat(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15)
  .gain(.55)
