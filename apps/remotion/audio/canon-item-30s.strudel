// canon-item-30s — "passive pulse", Canon family (Strudel score)
//
// Prebaked to public/audio/canon-item-30s.wav (gitignored artifact) by:
//   pnpm --filter @useaccord/remotion score canon-item-30s 30
// This exact file is also pasteable into https://strudel.cc (add
// `._punchcard()` to the last line there if you want the visualizer).
//
// 120 BPM grid: cpm 30 → 1 bar = 2.000s = 60 frames @30fps.
// Canon family: Eb major · loop Ebmaj9 · Cm9 · Abmaj9 · Gm7 · pluck hum accent (VCSL harp).
// bed runs the whole 30s; soft markers land on storyboard beats:
//   badge ignite 2.0 · submit rise 3.5 · pending tick 8.5 · listed bloom 14.0 ·
//   exit shadow 19.0 · takeaway rise 24.5 · wordmark button 27.5 · silent from 29.0
setcpm(30)

// ── bed ──
const kick = s("bd ~ bd ~").bank("RolandTR909").gain(.42) // pulse on 1 & 3
const tick = s("~ hh ~ hh").gain(.09).hpf(9000)           // whisper hats
const rimt = s("~ ~ rim ~").gain(.11)                     // one wooden tick per bar
// chord loop (one chord per bar): Ebmaj9 · Cm9 · Abmaj9 · Gm7
const arpE = note("eb3 [g3 bb3] [d4 f4] ~").s("piano").gain(.34).room(.35)
const arpC = note("c3 [g3 bb3] [d4 eb4] ~").s("piano").gain(.32).room(.35)
const arpA = note("ab2 [c3 eb3] [g3 bb3] ~").s("piano").gain(.32).room(.35)
const arpG = note("g2 [d3 f3] [bb3 d4] ~").s("piano").gain(.32).room(.35)
const pad = x => note(x).s("triangle").fm("<0 2 4>").clip(1).attack(.8).release(1.2).gain(.22).room(.4)
const hum = x => note(x).s("pluck").lpf(2600).gain(.18).room(.4) // canon accent: LPF'd harp pluck top line

// ── S1 hook · 0–3.5s — almost nothing ──
const b1 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.45), pad("eb2"))
const b2 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.45),
  note("[eb4,bb4] ~ ~ ~").s("piano").gain(.22).room(.45),  // LISTED badge ignites @2.0
  note("~ ~ ~ [g4 bb4]").s("piano").gain(.16).room(.5),    // submit rise @3.5→3.75
  pad("eb2"))

// ── S2 thesis · 4–8s — arps enter, hushed (01 · submit) ──
const b3 = stack(kick, arpC, tick, pad("c2"))
const b4 = stack(kick, arpA, tick, pad("ab2"))

// ── S2 body · 8–14s — loop steady (02 · pending) ──
const b5 = stack(kick, arpG, tick, pad("g2"),
  s("~ rim ~ ~").gain(.18))                                // pending wood tick @8.5
const b6 = stack(kick, arpE, tick, hum("d5"), pad("eb2"))
const b7 = stack(kick, arpC, tick, hum("eb5"), pad("c2"))

// ── S2 reveal · 14–16s — the earned state blooms (03 · listed) ──
const b8 = stack(kick, pad("ab2"),
  note("[ab3,c4,eb4,g4,bb4] ~ ~ ~").s("piano").gain(.3).room(.5).release(1.5)) // Abmaj9 bloom @14.0, ring damped

// ── S2 body · 16–24.5s — loop steady (listed tail · 04 · exit) ──
const b9 = stack(kick, arpG, tick, hum("f5"), pad("g2"))
const b10 = stack(kick, arpE, tick, pad("eb2"),
  note("~ ~ bb2 ~").s("piano").gain(.18).room(.5).release(1.5)) // exit shadow @19.0 — low, ring damped
const b11 = stack(kick, arpC, tick, pad("c2"))
const b12 = stack(kick, arpA, tick, pad("ab2"))

// ── S3 takeaway · 24.5–27.5s — bed thins so the text reads ──
const b13 = stack(s("bd ~ bd ~").bank("RolandTR909").gain(.4),
  note("g2 [d3 f3] [bb3 d4] ~").s("piano").gain(.28).room(.35).release(1.5), pad("g2"),
  note("~ [bb4 d5] ~ ~").s("piano").gain(.15).room(.5))    // "every state is earned" rise @24.5→24.75

// ── S4 end card · 27.5–30s — home ──
const b14 = stack(kick, arpE.release(.6), pad("eb2"),
  note("~ ~ ~ [eb4,eb5]").s("piano").gain(.24).room(.45).release(.5)) // wordmark button @27.5 — piano ring damped
const b15 = stack(s("bd ~ ~ ~").bank("RolandTR909").gain(.4),
  note("[eb3,g3,bb3,d4]").s("piano").sustain(.2).release(.8).gain(.3).room(.5)) // decays away by 29.0 — silent before 30

cat(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15)
  .gain(.55)
